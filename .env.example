# System Configuration
NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000

# Database & Vector Extension
POSTGRES_USER=aimms_user
POSTGRES_PASSWORD=aimms_secure_password_2026
POSTGRES_DB=aimms_db
DATABASE_URL=postgresql://aimms_user:aimms_secure_password_2026@postgres:5432/aimms_db?schema=public

# Redis & Queue Engine
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication Secrets
JWT_SECRET=ai-mms-production-jwt-super-secret-key-2026
JWT_EXPIRES_IN=7d

# AWS Cloud & Storage Services
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=ai-mms-media-storage
AWS_CLOUDFRONT_DOMAIN=d123456789.cloudfront.net

# AI Processing Models
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
VECTOR_DIMENSION=384

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
